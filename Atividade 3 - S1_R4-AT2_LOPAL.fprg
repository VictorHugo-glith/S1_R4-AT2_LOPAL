    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="altura" type="Real" array="False" size=""/>
            <output expression="&quot;Me diga sua altura em metros.&quot;" newline="True"/>
            <input variable="altura"/>
            <if expression="altura &gt;= 1.40">
                <then>
                    <output expression="&quot;Voc&#234; tem altura suficiente, logo sua entrada no brinquedo &#233; permitida.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Voc&#234; n&#227;o tem altura suficiente, logo sua entrada no brinquedo n&#227;o &#233; permitida.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
