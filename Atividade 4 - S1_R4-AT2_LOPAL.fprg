    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="senha, senhaCorreta" type="Integer" array="False" size=""/>
            <output expression="&quot;Por favor, digite sua senha.&quot;" newline="True"/>
            <input variable="senha"/>
            <output expression="&quot;Por favor, confirme sua senha.&quot;" newline="True"/>
            <input variable="senhaCorreta"/>
            <if expression="senha == senhaCorreta">
                <then>
                    <output expression="&quot;Sua senha est&#225; correta. Acesso permitido.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Sua senha est&#225; incorreta. Acesso negado.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
