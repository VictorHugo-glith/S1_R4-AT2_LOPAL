<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Atividade 2 - S1_R4-AT2_LOPAL"/>
        <attribute name="authors" value="I1HSA"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-13 11:29:09 "/>
        <attribute name="created" value="STFIU0E7RUNGUDUxMk4xMjYyODQ1OzIwMjYtMDQtMTM7IjExOjEwOjI2ICI7MjQwNg=="/>
        <attribute name="edited" value="STFIU0E7RUNGUDUxMk4xMjYyODQ1OzIwMjYtMDQtMTM7IjExOjI5OjA5ICI7MTsyNTI1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valorCompra, valorCashback, valorDesconto, valorFinal" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor de sua compra:&quot;" newline="True"/>
            <input variable="valorCompra"/>
            <assign variable="valorCashback" expression="valorCompra * 0.02"/>
            <assign variable="valorDesconto" expression="valorCompra - valorCashback"/>
            <assign variable="valorFinal" expression="valorCompra - valorCashback"/>
            <if expression="valorCompra &gt;= 150">
                <then>
                    <output expression="&quot;Parab&#233;ns, voc&#234; acabou de ganhar um desconto de 2%. O Valor de sua compra &#233; de: R$&quot; &amp; valorFinal &amp; &quot;.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Este &#233; o valor da sua compra: R$&quot;&amp; valorCompra &amp; &quot;,00. H&#225; um cahsback de 2% do valor de sua compra atual, resultando em: R$&quot;&amp; toFixed(valorCashback,2) &amp;&quot;.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
